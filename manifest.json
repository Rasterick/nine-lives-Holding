{
  "manifest_version": 3,
  "name": "NINE LIVES Console - Tactical Ingest",
  "version": "1.6.0",
  "description": "Tactical Wanderer wormhole map & universal zKillboard / Eve-Kill intelligence ingest",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NINE LIVES Tactical Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
